# Spotify API Credentials
# Erstellen unter: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# WICHTIG für Proxmox/Netzwerk-Deploy:
# Ersetze mit der IP deines Proxmox-Servers oder deiner Domain, z.B.:
# SPOTIPY_REDIRECT_URI=http://192.168.1.50:8000/callback
# SPOTIPY_REDIRECT_URI=https://spotify.deine-domain.de/callback
SPOTIPY_REDIRECT_URI=http://DEINE-PROXMOX-IP:8000/callback

# Google Gemini API Key
# Erstellen unter: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Port (optional, Standard: 8000)
APP_PORT=8000
